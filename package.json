{
  "name": "ai-cmo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:web": "turbo run dev --filter=@ai-cmo/web",
    "dev:api": "turbo run dev --filter=@ai-cmo/api",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "js-cookie@<3.0.7": ">=3.0.7",
      "postcss@<8.5.10": ">=8.5.10",
      "@opentelemetry/core@<2.8.0": ">=2.8.0",
      "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
      "undici@>=7.0.0 <7.30.2": "7.30.2",
      "vite@>=8.0.0 <8.1.6": "8.1.6",
      "glob@>=13.0.0 <13.0.7": "13.0.7"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
